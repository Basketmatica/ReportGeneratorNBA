# Copia a .streamlit/secrets.toml en local (no lo subas a git)
# o pégalo en Streamlit Cloud → Settings → Secrets.

BALLDONTLIE_API_KEY = "tu_clave_de_balldontlie"

# Proveedor LLM principal (gratis, sin tarjeta): console.groq.com
GROQ_API_KEY = "tu_clave_de_groq"

# Fallbacks opcionales:
# OPENROUTER_API_KEY = "tu_clave_de_openrouter"
# API_KEY = "tu_clave_de_gemini"     # si tu cuenta antigua conserva free tier
# LLM_PROVIDERS = "groq,openrouter,gemini"
# GROQ_MODEL = "llama-3.3-70b-versatile"
